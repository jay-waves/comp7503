  {
    "id": "4a99264f.206348",
    "type": "function",
    "z": "37f0ccf6.6b71cc",
    "name": "New Record Available",
    "func": "if (msg.statusCode !== 200 || !msg.payload || !msg.payload.temperature) {\n    node.error('HKO request failed or returned invalid weather data', msg);\n    return null;\n}\nconst time = new Date(msg.payload.updateTime);\nif (!Number.isFinite(time.getTime())) {\n    node.error('Invalid HKO updateTime', msg);\n    return null;\n}\nconst updateTime = time.toISOString();\nconst lastUpdateTime = flow.get('lastUpdateTime') || '';\nmsg.needUpdate = updateTime > lastUpdateTime;\nif (msg.needUpdate) {\n    msg.payload.updateTime = updateTime;\n    // mongodb4 insertOne expects an array of driver arguments.\n    msg.payload = [msg.payload];\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 605,
    "y": 177,
    "wires": [
      [
        "a5266dd0.531b08"
      ]
    ]
  },
