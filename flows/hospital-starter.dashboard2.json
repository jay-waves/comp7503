  {
    "id": "ae-http",
    "type": "http request",
    "z": "ha-tab",
    "name": "ae official JSON",
    "x": 400,
    "y": 345,
    "wires": [
      [
        "ae-prepare"
      ]
    ],
    "method": "GET",
    "ret": "obj",
    "url": "https://www.ha.org.hk/opendata/aed/aedwtdata2-en.json",
    "requestTimeout": "20000",
    "paytoqs": false,
    "persist": false
  },
  {
    "id": "ae-prepare",
    "type": "function",
    "z": "ha-tab",
    "name": "Validate and prepare idempotent write",
    "x": 400,
    "y": 380,
    "wires": [
      [
        "ae-save"
      ]
    ],
    "func": "if (msg.statusCode !== 200) { node.error('HTTP '+msg.statusCode,msg); return null; }\nconst data=msg.payload;\nconst now=new Date();\nif (!data || !Array.isArray(data.waitTime) || !data.waitTime.length || !data.updateTime || data.waitTime.some(r=>!r.hospName || !('t45p50' in r))) { node.error('AE schema changed',msg); return null; }\n// updateTime is Hong Kong local time; never parse dd/mm via new Date(string).\nconst m=data.updateTime.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})\\s+(\\d{1,2}):(\\d{2})\\s*(AM|PM)$/i);\nif (!m) { node.error('Unknown source timestamp',msg); return null; }\nlet h=Number(m[4])%12+(m[6].toUpperCase()==='PM'?12:0);\nconst sourceTime=new Date(`${m[3]}-${m[2]}-${m[1]}T${String(h).padStart(2,'0')}:${m[5]}:00+08:00`);\nif (!Number.isFinite(+sourceTime)) { node.error('Invalid source timestamp',msg); return null; }\nconst doc={_id:'ae:'+sourceTime.toISOString(), sourceTime, fetchedAt:now, sourceUrl:'https://www.ha.org.hk/opendata/aed/aedwtdata2-en.json', raw:data};\nmsg.view={...data,sourceISO:sourceTime.toISOString(),fetchedAt:now.toISOString()};\nmsg.payload=[{_id:doc._id},{$setOnInsert:doc,$set:{lastSeenAt:now}},{upsert:true}];\nreturn msg;",
    "outputs": 1,
    "noerr": 0
  },
  {
    "id": "ae-save",
    "type": "mongodb4",
    "z": "ha-tab",
    "name": "Upsert source records",
    "x": 400,
    "y": 415,
    "wires": [
      [
        "ae-view"
      ]
    ],
    "collection": "ha_ae_snapshots",
    "operation": "updateOne",
    "clientNode": "ha-mongo",
    "mode": "collection",
    "output": "toArray",
    "handleDocId": false
  },
  {
    "id": "sop-tick",
    "type": "inject",
    "z": "ha-tab",
    "name": "sop scheduled collection",
    "x": 400,
    "y": 450,
    "wires": [
      [
        "sop-http"
      ]
    ],
    "repeat": "86400",
